{
	"name": "thalles-me",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/node": "^26.4.1",
			"varlock": "1.18.0",
			"lucide-react": "^1.41.0",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"env:generate": "varlock codegen --path ./apps/web/",
		"postinstall": "varlock codegen --path ./apps/web/",
		"check": "biome check --write .",
		"start": "bun run --filter web start"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@thalles-me/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2"
	},
	"packageManager": "bun@1.4.3"
}
